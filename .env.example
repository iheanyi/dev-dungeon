# /dev/dungeon Server Configuration

# PostgreSQL connection URL (required for server mode)
DATABASE_URL=postgres://postgres:dev@localhost:5432/devdungeon?sslmode=disable

# Redis URL for leaderboards and real-time state
REDIS_URL=redis://localhost:6379

# SSH server settings
SSH_HOST=0.0.0.0
SSH_PORT=2222
SSH_HOST_KEY_PATH=.ssh/devdungeon_host_key

# Optional: HTTP server for web registration/leaderboards (future)
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8080
