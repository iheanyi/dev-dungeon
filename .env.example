# /dev/dungeon Server Configuration

# PostgreSQL connection URL (required for server mode)
# SECURITY: Use sslmode=require in production!
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/devdungeon?sslmode=disable

# Force SSL for database connections (auto-enabled when SENTRY_ENVIRONMENT=production)
# REQUIRE_DB_SSL=true

# Redis URL for leaderboards and real-time state (optional)
REDIS_URL=redis://localhost:6379

# SSH server settings
SSH_HOST=0.0.0.0
SSH_PORT=2222

# SSH host key path - IMPORTANT for persistence!
# The host key must be stored on a persistent volume to prevent
# "HOST IDENTIFICATION HAS CHANGED" warnings for users.
#
# Local development: .ssh/devdungeon_host_key (default)
# Docker Compose:    /app/.ssh/devdungeon_host_key (mounted volume)
# Fly.io production: /data/host_key (persistent volume)
#
# The key will be auto-generated (ed25519) if it doesn't exist.
SSH_HOST_KEY_PATH=.ssh/devdungeon_host_key

# HTTP server for web portal/leaderboards
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Web base URL for magic link authentication
# Users press Ctrl+L in the game to generate a browser login link
# Auto-detected from HTTP config if not set
# WEB_BASE_URL=http://localhost:8080

# Error tracking (optional)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=development
